# ===== 本地开发：全部留空即可（自动用 JSON 文件存储） =====
# ===== 云上部署：DATABASE_URL 必填，否则数据会随部署丢失 =====

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 签名密钥（云上必须改成长随机串；Render 蓝图会自动生成）
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL 连接串【云上必填】
# 不填 → 用容器内 JSON 文件（临时磁盘，每次部署/重启都会清空！）
# 例：postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 允许的前端来源（同源部署可保持 *）
CORS_ORIGIN=*

# 站点地址：用于拼接"重置密码"邮件里的链接（必须是你线上可访问的地址）
APP_URL=

# ===== 邮件服务（找回密码） =====
# 云服务器（Render 等）屏蔽 SMTP 端口；而且"免费邮箱地址 + 第三方代发"过不了 QQ 的 SPF/DKIM。
# 所以只有两条路：用 Gmail API（下面方式零），或自有域名 + Brevo。

# ---------- 方式零（推荐，0 元）：Gmail API ----------
# 用你自己的 Gmail 账号发信，Google 签名，SPF/DKIM 天然通过，走 HTTPS 443
# 获取 refresh_token：node tools/gmail-token.js --id <CLIENT_ID> --secret <CLIENT_SECRET>
# 注意：OAuth 同意屏幕要"发布应用"为正式版，否则 refresh_token 7 天失效
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---------- 方式一：Brevo（免费 300 封/天，需自有域名认证才稳） ----------
MAIL_FROM=
BREVO_API_KEY=

# ---------- 方式二：Mailjet（免费邮箱当发件人会被 QQ 拒收） ----------
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ---------- 方式三：Resend（需域名） ----------
RESEND_API_KEY=

# ---------- 管理员：手动重置密码 + 邮件通道自检 ----------
# 重置：POST /api/admin/reset   请求头 x-admin-token: <ADMIN_TOKEN>  body {"username":"xxx","password":"新密码"}
# 自检：POST /api/mail/diag     请求头 x-admin-token: <ADMIN_TOKEN>  body {"to":"你的邮箱"}（会真的发一封测试信）
ADMIN_TOKEN=

# ---------- 方式四：传统 SMTP（仅本地/自建服务器可用，云平台常超时） ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
