# ===== 本地开发：全部留空即可（自动用 JSON 文件存储） =====
# ===== 云上部署：至少填 DATABASE_URL，其余按需 =====

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 签名密钥（云上必须改成长随机串；Render 蓝图会自动生成）
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL 连接串（留空 = 使用本地 JSON 文件）
# 例：postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 允许的前端来源（同源部署可保持 *）
CORS_ORIGIN=*

# 站点地址：用于拼接"重置密码"邮件里的链接（必须是你线上可访问的地址）
# 例：https://dividend-flow-xxxx.onrender.com
APP_URL=

# ===== 邮件服务（找回密码需要；不配也能注册/登录，只是收不到重置邮件）=====
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_PASS=邮箱授权码（不是登录密码）
# 163/腾讯企业邮/Resend SMTP 同理
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
