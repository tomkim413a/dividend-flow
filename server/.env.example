# ===== 本地开发：全部留空即可（自动用 JSON 文件存储） =====
# ===== 云上部署：DATABASE_URL 必填，否则数据会随部署丢失 =====

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 签名密钥（云上必须改成长随机串；Render 蓝图会自动生成）
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL 连接串【云上必填】
# 不填 → 用容器内 JSON 文件（临时磁盘，每次部署/重启都会清空！）
# 例：postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 允许的前端来源（同源部署可保持 *）
CORS_ORIGIN=*

# 站点地址：用于拼接"重置密码"邮件里的链接（必须是你线上可访问的地址）
APP_URL=

# ===== 邮件服务（找回密码） =====
# 云服务器（Render 等）普遍屏蔽 SMTP 端口，线上请用下面的 HTTPS API 方式。

# 发件邮箱（必须是邮件服务商已验证的发件地址）
MAIL_FROM=

# 方式一（推荐）：Brevo，免费 300 封/天，HTTPS 走 443
BREVO_API_KEY=

# 方式二：Resend
RESEND_API_KEY=

# 方式三：传统 SMTP（仅本地/自建服务器可用，云平台常超时）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
